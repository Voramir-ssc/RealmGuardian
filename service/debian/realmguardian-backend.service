[Unit]
Description=RealmGuardian FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/RealmGuardian/backend
ExecStart=/opt/RealmGuardian/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
